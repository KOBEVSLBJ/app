{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "cc": ["./node_modules/cc/index.d.ts"]
    }
  },
  "include": [
    "assets/scripts/**/*.ts",
    "types/**/*.ts"
  ]
}
